{
  "system": {
    "monitor_interval_seconds": 30,
    "log_level": "INFO",
    "max_log_files": 10,
    "log_retention_days": 7
  },
  "thresholds": {
    "cpu_warning": 70,
    "cpu_critical": 90,
    "memory_warning": 75,
    "memory_critical": 90,
    "disk_warning": 80,
    "disk_critical": 95
  },
  "alerting": {
    "enabled": true,
    "email": {
      "smtp_server": "smtp.gmail.com",
      "smtp_port": 587,
      "sender_email": "your_email@gmail.com",
      "sender_password": "your_app_password",
      "recipient_emails": ["admin@example.com"]
    },
    "telegram": {
      "enabled": false,
      "bot_token": "YOUR_BOT_TOKEN",
      "chat_id": "YOUR_CHAT_ID"
    }
  },
  "monitoring": {
    "check_cpu": true,
    "check_memory": true,
    "check_disk": true,
    "check_network": true,
    "check_processes": true,
    "critical_processes": ["explorer.exe", "svchost.exe", "System"]
  }
}